# Copy this file to .env and fill in real values:
#   cp .env.example .env

# Picovoice Porcupine — https://console.picovoice.ai/
PICOVOICE_ACCESS_KEY=your_picovoice_access_key

# AssemblyAI realtime STT — https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=your_assemblyai_api_key

# SendAI / Agent Kit chat endpoint
AGENT_API_URL=https://express-agent-kit.onrender.com/api/chat

# WiFi hotspot for first-time config portal (Raspberry Pi AP mode)
HOTSPOT_SSID=Solera_config
HOTSPOT_PASSWORD=change_me_hotspot_password

# Optional: Edge Impulse (only needed for archive/wakeword_edge_impulse experiments)
EI_API_KEY=
EI_USERNAME=
EI_PASSWORD=
